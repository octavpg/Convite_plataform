# ==============================================================================
# CONVITE — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================
# Importante:
# - Este archivo DEBE estar en la raíz del proyecto (junto a package.json), NO en src/.env
# - Si aún no configuras Supabase, el proyecto iniciará automáticamente en MODO DEMO LOCAL
#   para que puedas correr `npm run dev` y hacer pruebas completas en el navegador de inmediato.
# ==============================================================================

# 1. URL de la aplicación local
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. Modo Demo (true = funciona sin Supabase/Postgres usando base de datos local en JSON;
#    cámbialo a "false" cuando coloques tus credenciales reales de Supabase abajo)
CONVITE_DEMO_MODE="true"

# 3. Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-de-supabase"

# 4. Supabase → Project Settings → Database → Connection string
# Pooler (puerto 6543, modo transacción) para runtime
DATABASE_URL="postgresql://postgres.tu-proyecto:tu-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (puerto 5432) para migraciones de Prisma
DIRECT_URL="postgresql://postgres.tu-proyecto:tu-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
